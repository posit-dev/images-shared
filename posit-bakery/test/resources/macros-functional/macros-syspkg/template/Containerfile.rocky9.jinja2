{#-
Every Containerfile.<os>.jinja2 in this image is identical; OS differences branch on
Image.OS so each scenario (variant) runs the same macros on every OS.
-#}
{%- import "apt.j2" as apt -%}
{%- import "dnf.j2" as dnf -%}
{%- if Image.OS.Family == "debian" -%}
{%- set pm = apt -%}
{%- set base_image = "docker.io/library/ubuntu:" ~ Image.OS.Version -%}
{%- else -%}
{%- set pm = dnf -%}
{%- set base_image = "docker.io/rockylinux/rockylinux:" ~ Image.OS.Version -%}
{%- endif -%}

FROM {{ base_image }}
LABEL org.opencontainers.image.base.name="{{ base_image }}"

ARG DEBIAN_FRONTEND=noninteractive
SHELL ["/bin/bash", "-euo", "pipefail", "-c"]

{% if Image.Variant == "setup" -%}
{{ pm.run_setup(pro_repo=True, open_repo=True) }}
{%- elif Image.Variant == "install" -%}
{{ pm.run_setup() }}

COPY {{ Path.Version }}/deps/packages-1.txt /tmp/packages-1.txt
COPY {{ Path.Version }}/deps/packages-2.txt /tmp/packages-2.txt
{{ pm.run_install(packages=["jq", "tree"], files=["/tmp/packages-1.txt", "/tmp/packages-2.txt"]) }}
{%- elif Image.Variant == "no-clean" -%}
{{ pm.run_setup() }}

RUN {{ pm.install(packages=["jq"], clean=False) | indent(4) }}
{%- elif Image.Variant == "upgrade" -%}
{{ pm.run_setup() }}

{{ pm.run_update_upgrade() }}
{%- else -%}
{{ raise("Unhandled variant '" ~ Image.Variant ~ "'") }}
{%- endif %}
