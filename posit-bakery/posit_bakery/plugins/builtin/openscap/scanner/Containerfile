# Scanner image for `bakery openscap scan`. Built locally on first use (tagged by a hash of this file).
# The scanned image is mounted read-only at /target; oscap runs as root so root-only files are readable.
# Base digest and package version are pinned so every machine builds the same scanner.
FROM docker.io/library/ubuntu:24.04@sha256:24737cef17f4e22b1977df7d9a05e77c4e28b7da5b8911f8d8ccda136bf3573c
RUN apt-get update \
    && apt-get install -y --no-install-recommends openscap-scanner=1.3.9+dfsg-1.1ubuntu2 \
    && rm -rf /var/lib/apt/lists/*
