{# Install Canonical's latest stable standalone release as root, after installing curl, ca-certificates, and jq. #}
{% macro install() -%}
ARG TARGETARCH
RUN case "$TARGETARCH" in \
      amd64|arm64) ;; \
      *) echo "Unsupported Pebble architecture: $TARGETARCH" >&2; exit 1 ;; \
    esac && \
    tmpdir="$(mktemp -d)" && \
    curl -fsSL https://api.github.com/repos/canonical/pebble/releases/latest -o "$tmpdir/release.json" && \
    version="$(jq -er '.tag_name | select(test("^v[0-9]+\\.[0-9]+\\.[0-9]+$"))' "$tmpdir/release.json")" && \
    asset="pebble_${version}_linux_${TARGETARCH}.tar.gz" && \
    sha256="$(jq -er --arg asset "$asset" \
      '.assets[] | select(.name == $asset) | .digest | strings | select(test("^sha256:[0-9a-f]{64}$")) | ltrimstr("sha256:")' \
      "$tmpdir/release.json")" && \
    curl -fsSL "https://github.com/canonical/pebble/releases/download/${version}/${asset}" \
      -o "$tmpdir/pebble.tar.gz" && \
    printf '%s  %s\n' "$sha256" "$tmpdir/pebble.tar.gz" | sha256sum -c - && \
    tar -xzf "$tmpdir/pebble.tar.gz" -C "$tmpdir" pebble COPYING && \
    install -D -m 0755 "$tmpdir/pebble" /usr/local/bin/pebble && \
    install -D -m 0644 "$tmpdir/COPYING" /usr/local/share/doc/pebble/COPYING && \
    rm -rf "$tmpdir"
{%- endmacro %}

{# Use a runtime-owned directory separate from the base image's Pebble plan. #}
{% macro configure(layer, owner) -%}
ENV PEBBLE=/var/lib/posit-pebble
RUN command -v pebble >/dev/null || { echo "Pebble must be installed and on PATH" >&2; exit 1; }; \
    install -d -m 0755 "$PEBBLE/layers" && chmod 0750 "$PEBBLE" && \
    chown {{ owner | quote }} "$PEBBLE"
COPY --chmod=0644 [{{ layer | tojson }}, "/var/lib/posit-pebble/layers/001-product.yaml"]
{%- endmacro %}


{# Both the base and standalone installations put Pebble on PATH. #}
{% macro entrypoint() -%}
ENTRYPOINT ["pebble", "run", "--verbose"]
{%- endmacro %}
